      "id": "5a6d4bd8-c635-48a4-8908-988a10200d47"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const text = JSON.stringify(item.json);\n  \n  // Regex mucho más estricta para evitar detectar rutas de archivos o basura\n  const emailRegex = /\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,7}\\b/g;\n  const foundEmails = text.match(emailRegex) || [];\n  // Lista negra ampliada para eliminar correos de sistemas o iconos\n  const blacklist = [\n    'example.com', 'sentry.io', 'wixpress.com', 'wordpress.org', \n    'schema.org', '2x.png', '3x.png', '1x.png', '.jpg', '.jpeg', '.webp'\n  ];\n  const cleanEmails = [...new Set(foundEmails)].filter(e => {\n    const email = e.toLowerCase();\n    return !blacklist.some(bad => email.includes(bad));\n  });\n  const datosNegocio = item.pairedItem.json;\n  return {\n    json: {\n      ...datosNegocio,\n      // Si no hay email, dejamos un texto vacío \"\" (como pediste)\n      email: cleanEmails.length > 0 ? cleanEmails[0] : \"\" \n    }\n  };\n});"
      },
