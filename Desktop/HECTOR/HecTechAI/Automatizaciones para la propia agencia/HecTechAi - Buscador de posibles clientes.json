        "jsCode": "const existing = $input.all().map(r => r.json.NOMBRE || \"\");\nreturn { \n  negocio: $('Configurador de Búsqueda1').item.json.negocio, \n  ciudad: $('Configurador de Búsqueda1').item.json.ciudad,\n  existentes: existing\n};"
