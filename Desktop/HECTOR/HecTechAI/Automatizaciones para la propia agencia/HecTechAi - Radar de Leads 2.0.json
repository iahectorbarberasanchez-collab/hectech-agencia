      "parameters": {
        "jsCode": "const text = JSON.stringify($input.all());\nconst instagram = text.match(/instagram\\.com\\/([^\\/\\?\\s\"']+)/)?.[0] || \"\";\nconst facebook = text.match(/facebook\\.com\\/([^\\/\\?\\s\"']+)/)?.[0] || \"\";\nconst linkedin = text.match(/linkedin\\.com\\/(?:company|in)\\/([^\\/\\?\\s\"']+)/)?.[0] || \"\";\n\nreturn {\n  json: {\n    ...$node[\"Split Results1\"].json,\n    instagram,\n    facebook,\n    linkedin,\n    has_social: (instagram || facebook || linkedin) ? \"SÍ\" : \"NO\"\n  }\n};"
