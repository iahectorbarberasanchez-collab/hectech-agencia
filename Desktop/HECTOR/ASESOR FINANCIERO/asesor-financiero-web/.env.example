# ------------------------------------------------------------------------------
# ASESOR FINANCIERO IA — Variables de entorno requeridas
# Copia este archivo como .env.local y rellena los valores
# ------------------------------------------------------------------------------

# ── IA PRINCIPAL (elige uno) ───────────────────────────────────────────────────
# Puedes forzar el proveedor con AI_PROVIDER= (openrouter | ollama | groq | google)
# Si no lo defines, el sistema elige automáticamente según qué API KEY esté configurada.
# AI_PROVIDER=openrouter

# ════════════════════════════════════════════════════════════════
# OPCIÓN 1 — OpenRouter (RECOMENDADO ✅ — Gratuito, ilimitado*, 128k contexto)
# Modelos gratuitos disponibles: DeepSeek V3, DeepSeek R1, Qwen3 235B...
# Registro GRATIS: https://openrouter.ai → Settings → API Keys
# * Límite: ~200 req/día en modelos :free. Sin tarjeta de crédito.
# ════════════════════════════════════════════════════════════════
OPENROUTER_API_KEY="sk-or-v1-..."

# Modelo a usar (por defecto: DeepSeek V3 free — excelente para tool-calling y análisis financiero)
# Otros modelos gratuitos: qwen/qwen3-235b-a22b:free | deepseek/deepseek-r1:free | qwen/qwen3-30b-a3b:free
# Ver todos los modelos gratis: https://openrouter.ai/models?q=:free
OPENROUTER_MODEL="deepseek/deepseek-chat-v3-0324:free"

# ════════════════════════════════════════════════════════════════
# OPCIÓN 2 — Ollama LOCAL (⚡ Completamente gratuito e ilimitado — corre en tu máquina)
# Instalar Ollama: https://ollama.ai
# Descargar modelos: ollama pull qwen3:14b | ollama pull deepseek-r1:14b
# Necesitas al menos 8GB VRAM/RAM para qwen3:8b, 12GB para qwen3:14b
# ════════════════════════════════════════════════════════════════
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="qwen3:14b"      # Recomendado: mejor tool-calling en Ollama
# Alternativas: qwen3:8b | qwen3:4b | deepseek-r1:14b | deepseek-r1:7b

# ════════════════════════════════════════════════════════════════
# OPCIÓN 3 — Groq (gratuito con límite 12k-20k tokens/minuto)
# Registro: https://console.groq.com → "Create API Key"
# ════════════════════════════════════════════════════════════════
GROQ_API_KEY="gsk_..."

# OPCIÓN 4 — Google Gemini (fallback de último recurso)
# https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# URL de la app (usada en cabeceras HTTP-Referer para OpenRouter)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
