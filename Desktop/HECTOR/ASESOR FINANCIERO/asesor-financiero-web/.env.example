# ------------------------------------------------------------------------------
# ASESOR FINANCIERO IA — Variables de entorno requeridas
# Copia este archivo como .env.local y rellena los valores
# ------------------------------------------------------------------------------

# ── IA PRINCIPAL (elige uno) ───────────────────────────────────────────────────

# OPCIÓN 1 — Groq (RECOMENDADO: gratuito, 14.400 req/día, sin tarjeta de crédito)
# Registro: https://console.groq.com → "Create API Key"
GROQ_API_KEY="gsk_..."

# OPCIÓN 2 — Google Gemini (plan gratuito o pay-as-you-go)
# Si defines GROQ_API_KEY, Gemini se usa como fallback automáticamente
# https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
